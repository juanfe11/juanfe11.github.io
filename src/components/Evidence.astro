---
import diagrams from '../data/diagrams.json';
import { withBase } from '../lib/assetPath';

const categories = [
  { name: 'Normalización', description: 'Próximamente: ejercicios de normalización de bases de datos.' },
  { name: 'SQL', description: 'Próximamente: scripts y consultas SQL.' },
  { name: 'Proyecto', description: 'Próximamente: avances del proyecto final.' },
];
---

<section id="evidencias" class="evidence-section">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl py-24">
    <h2 class="section-title">Evidencias</h2>
    <p class="section-subtitle">Aquí iré publicando las evidencias del curso a lo largo del semestre.</p>

    <h3 class="subsection-title">Modelado — Diagramas Entidad-Relación</h3>
    <div class="diagram-grid">
      {diagrams.map((d) => (
        <a href={withBase(d.image)} target="_blank" rel="noopener" class="diagram-card">
          <img src={withBase(d.image)} alt={d.title} loading="lazy" />
          <div class="diagram-info">
            <h4>{d.title}</h4>
            <p>{d.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="evidence-grid">
      {categories.map((cat) => (
        <div class="evidence-card">
          <h3>{cat.name}</h3>
          <p>{cat.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .evidence-section {
    background-color: var(--bg);
  }
  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }
  .subsection-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .diagram-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .diagram-card {
    display: block;
    background: var(--bg-card);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .diagram-card:hover {
    transform: translateY(-4px);
  }
  .diagram-card img {
    width: 100%;
    height: 220px;
    object-fit: contain;
    background: #fff;
    display: block;
  }
  .diagram-info {
    padding: 1rem;
  }
  .diagram-info h4 {
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .diagram-info p {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .evidence-card {
    background: var(--bg-card);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }
  .evidence-card h3 {
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .evidence-card p {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .diagram-grid,
    .evidence-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
